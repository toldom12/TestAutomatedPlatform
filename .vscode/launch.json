{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Debug pytest",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "automated_tests",
                "-v",
                "-s"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}